<div class="shot">
  <img src="<%= "/media/#{photo.human_name}/#{photo.version}" %>" loading="lazy"
       alt="<%= photo.alt_text %>">
  <div class="meta">
    <div class="name"><%= photo.human_name %>
      <span class="muted">v<%= photo.version %></span></div>

    <% if photo.human_name.start_with?("new-") %>
      <p class="muted" style="margin:.2rem 0 0">needs a proper name</p>
    <% end %>

    <p class="alt">
      <%= photo.alt_text.presence || content_tag(:em, "description being written…") %>
    </p>

    <%= form_with url: admin_photo_path(photo), method: :patch, style: "margin-top:.4rem" do %>
      <%= text_field_tag :tags, nil, placeholder: photo.tag_labels.any? ? photo.tag_labels.join(", ") : "add a tag…" %>
    <% end %>
  </div>
</div>
