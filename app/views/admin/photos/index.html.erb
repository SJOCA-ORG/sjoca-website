<% content_for :title, "Photographs" %>

<div class="row">
  <h1 class="grow" style="margin:0">Photographs</h1>
  <span class="muted"><%= pluralize(Photo.published.count, "photograph") %>,
    <%= pluralize(Tag.count, "tag") %></span>
</div>

<%# Upload. Several at once, tagged together, because that is how a parish
    actually works: somebody comes back from a feast with thirty pictures. %>
<div class="card" style="margin-top:1rem">
  <strong>Add photographs</strong>
  <%= form_with url: admin_photos_path, multipart: true, class: "upload" do |f| %>
    <p style="margin:.6rem 0">
      <%= f.file_field :files, multiple: true, accept: "image/*,video/mp4,video/quicktime,video/mpeg,video/webm,video/x-m4v,video/x-msvideo,video/3gpp,.mp4,.mov,.mpeg,.mpg,.m4v,.webm,.avi,.3gp", id: "files" %>
    </p>

    <p style="margin:.6rem 0">
      <label class="muted" style="display:block;margin-bottom:.3rem">
        Tag all of these as — pick any, or type a new one
      </label>
      <span class="tagpicker">
        <% Tag.in_menu.each do |tag| %>
          <label class="tagchip">
            <%= check_box_tag "tags[]", tag.label, false, id: "tag-#{tag.id}" %>
            <%= tag.label %> <span class="muted"><%= tag.photos.count %></span>
          </label>
        <% end %>
      </span>
      <%= text_field_tag "tags[]", nil, placeholder: "or a new tag…",
            style: "margin-top:.5rem;max-width:18rem" %>
    </p>

    <p style="margin:.6rem 0 0">
      <%= f.submit "Upload", class: "btn" %>
      <span class="muted" style="margin-left:.6rem">
        Location data is removed from every photograph as it arrives, and a description
        is written for it automatically. Drop a video in and you get a still picture
        from it — the clip itself is not kept.
      </span>
    </p>
  <% end %>
</div>

<% if @recent.any? %>
  <h2>Just added</h2>
  <div class="grid">
    <% @recent.each do |photo| %>
      <%= render "photo", photo: photo %>
    <% end %>
  </div>
<% end %>

<h2>
  <%= @filter ? "Tagged #{@filter}" : "All photographs" %>
  <% if @filter %><%= link_to "show all", admin_photos_path, class: "muted" %><% end %>
</h2>

<div class="row" style="margin-bottom:.8rem">
  <%= form_with url: admin_photos_path, method: :get, class: "row" do %>
    <%= text_field_tag :q, params[:q], placeholder: "search descriptions…", style: "max-width:16rem" %>
    <%= hidden_field_tag :tag, @filter %>
    <%= submit_tag "Search", class: "btn ghost" %>
  <% end %>
  <span class="grow"></span>
  <% @tags.each do |tag| %>
    <%= link_to "#{tag.label} (#{tag.photos.size})", admin_photos_path(tag: tag.name),
          class: "tag", style: ("background:var(--ink);color:#fff" if @filter == tag.name) %>
  <% end %>
</div>

<datalist id="known-tags">
  <% Tag.in_menu.each { |t| %><option value="<%= t.label %>"><% } %>
</datalist>

<div class="grid">
  <% @photos.each do |photo| %>
    <%= render "photo", photo: photo %>
  <% end %>
</div>

<script>
  // Videos become stills before the form is sent, so a huge clip never leaves
  // this machine. See the layout for why.
  (function () {
    var input = document.getElementById("files");
    if (!input || !window.stillsFromVideos) return;

    var note = document.createElement("p");
    note.className = "muted";
    note.style.margin = ".4rem 0 0";
    input.parentNode.appendChild(note);

    input.addEventListener("change", function () {
      note.textContent = "";
      window.stillsFromVideos(input).then(function (what) {
        if (what.converted.length) {
          note.textContent = what.converted.length + " video" +
            (what.converted.length === 1 ? "" : "s") +
            " turned into still pictures here — the clips are not uploaded.";
        }
        if (what.uploaded.length) {
          note.textContent += " " + what.uploaded.length +
            " could not be read in this browser, so the whole file will be sent.";
        }
      });
    });
  })();
</script>

<script>
  // Saves when you leave the field. Typing a name and clicking away is what
  // people actually do, and before this it silently discarded the name and
  // left the "needs a proper name" warning standing.
  //
  // Enter still works -- it is an ordinary single-field form -- and leaving a
  // field you did not change submits nothing.
  (function () {
    document.addEventListener("focusout", function (e) {
      var field = e.target;
      if (!field.matches(".shot input[type=text]")) return;

      var value = field.value.trim();
      if (value === (field.dataset.original || "")) return;
      if (value === "" && field.classList.contains("name-field")) {
        field.value = field.dataset.original;   // a photograph must keep a name
        return;
      }

      field.dataset.original = value;   // so a second blur does not save again
      field.form.requestSubmit();
    });
  })();
</script>

<style>
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1rem }
  .shot { border:1px solid var(--rule); border-radius:8px; overflow:hidden; background:#fff }
  .shot img { width:100%; height:150px; object-fit:cover; display:block; background:var(--band) }
  .shot .meta { padding:.5rem .6rem; font-size:.82rem }
  .shot .name { font-weight:600; word-break:break-all }
  .shot .alt { color:#666; margin:.3rem 0 0; max-height:3.6em; overflow:hidden }
  .shot input[type=text] { font-size:.8rem; padding:.25rem .4rem; width:100% }
  .shot .name-field { font-weight:600; border:1px solid transparent; background:transparent;
                      padding:.15rem .25rem; margin:-.15rem -.25rem }
  .shot .name-field:hover { border-color:var(--rule); background:#fff }
  .shot .name-field:focus { border-color:var(--ink); background:#fff; outline:none }
  .shot .needs { color:var(--maroon); font-size:.78rem; margin:.25rem 0 0 }
  .shot .tags { margin:.35rem 0 .3rem; display:flex; flex-wrap:wrap; gap:.25rem }
  .shot .pill { background:var(--band); border-radius:99px; padding:.05rem .45rem; font-size:.75rem }
  .shot .rename { margin-bottom:.1rem }
  .linky { border:0; background:none; color:var(--maroon); cursor:pointer;
           font:inherit; font-size:.78rem; text-decoration:underline; padding:0 }
  .shot form { margin:0 }
  .tagpicker { display:flex; flex-wrap:wrap; gap:.4rem }
  .tagchip { border:1px solid var(--rule); border-radius:99px; padding:.2rem .6rem;
             font-size:.85rem; cursor:pointer; display:inline-flex; align-items:center; gap:.3rem }
  .tagchip:has(input:checked) { background:var(--ink); color:#fff; border-color:var(--ink) }
  .tagchip input { margin:0 }
  a.tag { text-decoration:none; color:inherit }
</style>
