<% content_for :title, @revision.title %>
<% content_for :main_class, "workbench" %>

<%# Two panes. The controls and the conversation are narrow and on the left;
    the right is the actual page, at full width or at phone width. Judging a
    change by reading a description of it is not the same as looking at it, and
    until now looking meant opening another tab and remembering to refresh. %>

<aside class="pane-left">
  <div class="fixed top">
<div class="row">
  <h1 class="grow" style="margin:0"><%= @revision.title %></h1>
  <span class="muted"><%= @revision.summary %></span>
</div>

<%# A running total for this revision. Development only -- it comes out before
    the parish sees this -- but while the question is "can a parish afford to
    edit its own website", the answer should be a number on the screen rather
    than a developer's recollection. The underlying usage is kept on every
    message either way, so the log survives the meter being removed. %>
<%# How this revision will present itself to a search engine. Shown before
    publishing, every time, because these go wrong silently and stay wrong for
    months. It reports and does not block: a description is parish writing. %>
<% seo = Site::SeoCheck.call(@revision) %>
<% if seo[:problems].any? %>
  <details class="card" style="margin-top:.6rem;border-color:#E6D9A8;background:#FDF6E3">
    <summary style="cursor:pointer">
      <strong><%= pluralize(seo[:problems].size, "thing") %></strong> that would make this site
      harder to find <span class="muted">— across <%= seo[:checked] %> pages</span>
    </summary>
    <ul style="margin:.6rem 0 0;padding-left:1.1rem;font-size:.85rem;line-height:1.5">
      <% seo[:problems].first(20).each do |problem| %>
        <li><%= problem %></li>
      <% end %>
    </ul>
    <p class="muted" style="margin:.6rem 0 0;font-size:.8rem">
      Ask the admin to fix any of these — "give every page its own description" works.
    </p>
  </details>
<% end %>

<% spent = Admin::Cost.of_revision(@revision) %>
<% if spent.positive? %>
  <div class="row" style="margin:.6rem 0 0;padding:.45rem .7rem;border:1px dashed var(--rule);
                          border-radius:8px;font-size:.85rem">
    <span class="muted">This revision has cost</span>
    <strong><%= Admin::Cost.format(spent) %></strong>
    <% turns = @revision.messages.count { |m| m.usage.present? } %>
    <span class="muted">over <%= pluralize(turns, "change") %>
      (<%= Admin::Cost.format(spent / turns) %> each)</span>
    <% saved = @revision.messages.filter_map(&:usage).sum { |u| Admin::Cost.uncached(u) } - spent %>
    <% if saved > 0.005 %>
      <span class="grow"></span>
      <span class="muted">caching saved <%= Admin::Cost.format(saved) %></span>
    <% end %>
  </div>
<% end %>
<div class="row" style="margin:1rem 0">
  <%# A signed link, opened in a new tab: looking at the draft should not take
      you out of the conversation, and should not disturb the admin session. %>
  <%= link_to "View this draft ↗", "/?preview=#{@revision.preview_token}",
        class: "btn", target: "_blank", rel: "noopener" %>
  <%= link_to "Browse it in place", preview_admin_revision_path(@revision), class: "btn ghost" %>
  <%= button_to "Publish", publish_admin_revision_path(@revision), class: "btn",
        form: { style: "display:inline" },
        data: { turbo_confirm: "Publish this revision? The live site changes immediately." } %>
  <span class="grow"></span>
  <%= link_to "All revisions", admin_root_path, class: "btn ghost" %>
</div>
    <% if @working %>
      <%# Pinned, deliberately. A thirty-step turn scrolls its own progress out
          of sight, and a page with no sign of life is indistinguishable from a
          broken one. The steps stream below; this says it is still going. %>
      <% queued = @messages.count { |m| m.state == "working" } - 1 %>
      <div class="working-bar" id="working-bar" data-since="<%= @working.created_at.to_i %>">
        <strong id="working-word">
          <%= @working.stopping? ? "Stopping" : "Working" %><span class="dots">…</span>
        </strong>
        <%# A request typed while another is running waits its turn. It used to
            start a second job on the same revision, racing the first, and the
            page only showed one of them -- so the second looked swallowed. %>
        <% if queued.positive? %>
          <span class="muted">(<%= pluralize(queued, "more request") %> waiting)</span>
        <% end %>
        <span id="working-clock" style="font-variant-numeric:tabular-nums">0s</span>
        <span id="working-cost" class="muted"></span>
        <span class="grow"></span>
        <%# Visible the whole time a turn runs. Realising it has misunderstood
            you and having to watch it work anyway is the worst minute in this
            whole interface. %>
        <%= button_to "Stop", stop_admin_revision_path(@revision),
              class: "linky", form: { style: "display:inline" } %>
        <span class="latest" id="working-latest"></span>
      </div>
    <% end %>
  </div>

  <div class="scroller" id="scroller">
<%# A new outbound connection must never be invisible to whoever approves the
    change. The list of allowed domains is deliberately open -- see
    docs/TODO.md -- so this is the control that replaces an allowlist. %>
<% fresh = @revision.new_domains %>
<% if fresh.any? %>
  <div class="card" style="border-color:#8B1A1A">
    <strong>This change fetches data from somewhere new</strong>
    <p style="margin:.7rem 0 0;padding:.6rem .8rem;background:#FBEAEA;border-radius:6px">
      <% fresh.each do |domain| %>
        <strong style="color:#8B1A1A"><%= domain %></strong><br>
      <% end %>
      <span class="muted" style="font-size:.85rem">
        The site has not pulled data from
        <%= fresh.size == 1 ? "this address" : "these addresses" %> before. Our server
        fetches it and passes it to the page. Worth checking with whoever looks after
        the technical side before approving.
      </span>
    </p>
  </div>
<% end %>

<% changes = @revision.promise_changes %>
<% if changes[:added].any? || changes[:removed].any? %>
  <div class="card" style="border-color:#8B1A1A">
    <strong>Changes to what this site promises</strong>

    <% changes[:removed].each do |p| %>
      <%# Louder than an addition, deliberately. %>
      <p style="margin:.7rem 0 0;padding:.6rem .8rem;background:#FBEAEA;border-radius:6px">
        <strong style="color:#8B1A1A">No longer checked:</strong>
        <%= p.summary %>
        <span class="muted">— <%= p.scope_text %>, <%= p.age_text %></span>
        <br>
        <span class="muted" style="font-size:.85rem"><%= p.intent %></span>
      </p>
    <% end %>

    <% changes[:added].each do |p| %>
      <p style="margin:.5rem 0 0">
        <strong>Now promised:</strong> <%= p.summary %>
        <span class="muted">— <%= p.scope_text %></span>
        <details style="margin-top:.2rem">
          <summary class="muted" style="font-size:.85rem;cursor:pointer">why</summary>
          <span class="muted" style="font-size:.85rem"><%= p.intent %></span>
        </details>
      </p>
    <% end %>
  </div>
<% end %>
<div class="chat">
  <% if @messages.empty? %>
    <p class="empty">
      Describe a change in plain language — "move the service times above the photo on
      the home page", "add a paragraph to Giving about the fall appeal".
      Nothing you do here touches the live site until you publish.
    </p>
  <% end %>

  <% @messages.each do |m| %>
    <% if m.working? %>
      <%# Still thinking. Shows each step as it happens, so it is visibly alive. %>
      <%# The clock and the "working" label live in the pinned bar at the top of
          this pane, not here, so they stay visible however far the steps run. %>
      <div class="msg assistant" id="working" data-since="<%= m.created_at.to_i %>">
        <span class="tools" id="working-steps" style="border-top:0;padding-top:0">
          <% Array(m.progress).each do |t| %>
            <% label = t["say"].presence || t["summary"].presence || t["name"] %>
            <% next if label.blank? %>
            <span style="<%= "color:#8B1A1A" if t["failed"] %>"><%=
              t["say"] ? "" : (t["read"] ? "· " : "→ ") %><%= label %></span>
          <% end %>
        </span>
      </div>
    <% else %>
      <%# A round that ran on into another is not a finished reply, and showing
          it the same way makes a long job look like a series of failures. %>
      <% carrying_on = m.role == "assistant" && m.content.to_s.end_with?("Carrying on.") %>
      <div class="msg <%= m.role %><%= " interim" if carrying_on %>">
        <%= m.content %>
        <% if m.touched.present? %>
          <span class="tools" style="border-top:0;padding-top:.3rem">
            <% Array(m.touched).first(4).each do |slug| %>
              <%= link_to "see /#{slug} ↗",
                    "/#{slug == 'home' ? '' : slug}?preview=#{@revision.preview_token}",
                    target: "_blank", rel: "noopener",
                    style: "margin-right:.7rem" %>
            <% end %>
          </span>
        <% end %>
        <% if m.tool_calls.present? %>
          <details class="tools">
            <summary style="cursor:pointer;color:#666">
              what it did<% if m.usage.present? %>
                — <%= m.usage["calls"] %> calls,
                <%= number_with_delimiter(m.usage["input"].to_i + m.usage["output"].to_i) %> new
                <%- cached = m.usage["cache_read"].to_i -%>
                <%= "+ #{number_with_delimiter(cached)} cached" if cached.positive? %>,
                <strong><%= Admin::Cost.format(Admin::Cost.of(m.usage)) %></strong>
                <%- saved = Admin::Cost.uncached(m.usage) - Admin::Cost.of(m.usage) -%>
                <%= "(saved #{Admin::Cost.format(saved)})" if saved > 0.005 %>
              <% end %>
            </summary>
            <% Array(m.tool_calls).each do |t| %>
              <% if t["say"] %>
                <span style="color:#444;font-style:italic"><%= t["say"] %></span><br>
              <% elsif !t["read"] %>
                <span style="<%= "color:#8B1A1A" if t["failed"] %>">→ <%= t["summary"].presence || t["name"] %></span><br>
              <% end %>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
  </div>

  <div class="fixed bottom">
<%# Only a draft can be edited. Without this the box accepted a request on a
    published or discarded revision, enqueued it, and failed a minute later
    with "revision 47 is not a draft" -- which reads like a system fault
    rather than "you are on the wrong page". %>
<% if @revision.editable? %>
  <%# Photographs go WITH the message, not before it. "Replace Fr David's photo
      with the one I am about to upload" only works if the upload and the
      sentence arrive together -- otherwise the turn starts first and has to
      guess which photographs are the new ones. %>
  <%= form_with url: admin_revision_messages_path(@revision), method: :post,
                multipart: true, id: "say" do |f| %>
    <div id="drop">
      <%= f.text_area :content, rows: 3, autofocus: true,
            placeholder: "What would you like to change? Drop photographs here to add them." %>
    </div>

    <div id="attached" hidden>
      <span class="muted" id="attached-count"></span>
      <span id="attached-names" class="muted"></span>
      <button type="button" id="attached-clear" class="linky">remove</button>

      <%# The confusing moment is after the drop: nothing says a choice is
          waiting, so the next thing you type silently arrives carrying the
          photographs. Say so, and make "just save them" a button rather than
          a sentence somebody has to compose. %>
      <p class="attached-ask">
        <strong>These are waiting.</strong>
        Tell me what to do with <span id="attached-them">them</span> in the box above
        — or
        <%# A button, not another form. button_to builds a <form>, and a form
            inside a form is invalid HTML: the parser closes the outer one at
            the inner, orphaning the textarea and Send button so that NOTHING
            submitted. formaction sends this one button somewhere else and
            carries the same files and tags with it. %>
        <button type="submit" class="linky"
                formaction="<%= admin_photos_path %>" formmethod="post"
                formenctype="multipart/form-data">just save them to the library</button>.
        <%= hidden_field_tag :return_to, request.fullpath %>
      </p>
      <p class="muted" style="margin:.3rem 0 0;font-size:.78rem">
        Until you do one or the other, whatever you send next will be about
        <span class="attached-them">them</span>.
      </p>
      <div style="margin-top:.4rem">
        <%= text_field_tag "tags[]", nil, id: "attach-tags",
              placeholder: "tag these photographs…", list: "known-tags",
              style: "font-size:.85rem;padding:.3rem .5rem;width:100%" %>
        <datalist id="known-tags">
          <% Tag.in_menu.each { |t| %><option value="<%= t.label %>"><% } %>
        </datalist>
      </div>
    </div>

    <p style="margin:.6rem 0 0;display:flex;align-items:center;gap:.6rem">
      <%= f.submit "Send", class: "btn" %>
      <label class="btn ghost" style="cursor:pointer;margin:0">
        Add photos or video
        <%= f.file_field :files, multiple: true, accept: "image/*,video/mp4,video/quicktime,video/mpeg,video/webm,video/x-m4v,video/x-msvideo,video/3gpp,.mp4,.mov,.mpeg,.mpg,.m4v,.webm,.avi,.3gp",
              id: "files", style: "display:none" %>
      </label>
      <span class="grow"></span>
      <%= link_to "Photo library ↗", admin_photos_path, class: "muted",
            target: "_blank", rel: "noopener" %>
    </p>
  <% end %>

  <style>
    #drop.over textarea { outline:2px dashed var(--maroon); outline-offset:2px }
    #attached { margin-top:.5rem; padding:.55rem .7rem; border:1px solid #E6D9A8;
                border-radius:8px; font-size:.85rem; background:#FDF6E3 }
    .attached-ask { margin:.5rem 0 0 }
    .linky { border:0; background:none; color:var(--maroon); cursor:pointer;
             font:inherit; text-decoration:underline; padding:0 }
  </style>

  <script>
    (function () {
      var input = document.getElementById("files");
      var drop = document.getElementById("drop");
      var panel = document.getElementById("attached");
      var count = document.getElementById("attached-count");
      var names = document.getElementById("attached-names");
      if (!input || !drop) return;

      // Turn any videos into stills first, then describe what is attached.
      function show() {
        if (window.stillsFromVideos) {
          window.stillsFromVideos(input).then(function (what) {
            if (what.converted.length) {
              lastConverted = what.converted;
              lastUploaded = what.uploaded;
            }
            describe();
          });
        } else {
          describe();
        }
      }

      var lastConverted = [], lastUploaded = [];

      function describe() {
        var files = input.files;
        panel.hidden = !files || !files.length;
        if (panel.hidden) return;
        var one = files.length === 1;
        count.textContent = (one ? "1 photograph attached" : files.length + " photographs attached") +
          (lastConverted.length
            ? " (" + (lastConverted.length === 1 ? "one is a still taken from a video"
                                                 : lastConverted.length + " are stills taken from videos") +
              " — the video itself is not uploaded)"
            : "") +
          (lastUploaded.length
            ? " (" + lastUploaded.length + " could not be read here, so the whole file will be sent)"
            : "") + ":";
        names.textContent = [].map.call(files, function (f) { return f.name; }).join(", ");
        [].forEach.call(document.querySelectorAll("#attached-them, .attached-them"),
          function (el) { el.textContent = one ? "it" : "them"; });

        // Nothing to copy anywhere: "just save them" is a button in THIS form
        // that posts to a different address, so it already has the files.
      }

      input.addEventListener("change", show);

      document.getElementById("attached-clear").addEventListener("click", function () {
        input.value = "";
        document.getElementById("attach-tags").value = "";
        lastConverted = []; lastUploaded = [];
        describe();
      });

      // Dropping onto the box you are typing in is the obvious gesture, and it
      // keeps the photographs attached to the sentence rather than sent ahead
      // of it.
      ["dragenter", "dragover"].forEach(function (e) {
        drop.addEventListener(e, function (ev) {
          ev.preventDefault(); drop.classList.add("over");
        });
      });
      ["dragleave", "drop"].forEach(function (e) {
        drop.addEventListener(e, function (ev) {
          ev.preventDefault(); drop.classList.remove("over");
        });
      });
      drop.addEventListener("drop", function (ev) {
        // Videos too: one becomes a still picture. A phone drops .mov with an
        // empty type often enough that the extension has to be trusted as well.
        var dropped = [].filter.call(ev.dataTransfer.files, function (f) {
          if (f.type.indexOf("image/") === 0 || f.type.indexOf("video/") === 0) return true;
          return /\.(jpe?g|png|gif|webp|heic|heif|mp4|mov|mpe?g|m4v|webm|avi|3gp)$/i.test(f.name);
        });
        if (!dropped.length) return;

        var box = new DataTransfer();
        [].forEach.call(input.files, function (f) { box.items.add(f); });
        dropped.forEach(function (f) { box.items.add(f); });
        input.files = box.files;
        show();
      });
    })();
  </script>
<% else %>
  <div class="card" style="border-color:#8B1A1A">
    <strong>
      <%= @revision.live? ? "This is the live site." : "This draft is closed." %>
    </strong>
    <p style="margin:.5rem 0 0" class="muted">
      <%= if @revision.live?
            "Published revisions are not edited directly — changes are made in a draft and published."
          elsif @revision.state == "discarded"
            "It was discarded, so it can be read but not changed."
          else
            "It has been superseded by a later revision."
          end %>
      Everything said here is kept.
    </p>
    <p style="margin:.8rem 0 0">
      <%= button_to "Start a new draft from the live site", admin_revisions_path,
            method: :post, class: "btn", form: { style: "display:inline" } %>
    </p>
  </div>
<% end %>
  </div>
</aside>

<section class="pane-right">
  <div class="preview-bar">
    <%# No page selector: you navigate by clicking the site, as a visitor would.
        This just says where you are. %>
    <span id="preview-where" class="muted" style="font-variant-numeric:tabular-nums">/</span>

    <div class="seg" role="group" aria-label="Preview width">
      <button type="button" id="w-wide" aria-pressed="true">Desktop</button>
      <button type="button" id="w-phone" aria-pressed="false">Phone</button>
    </div>

    <button type="button" class="btn ghost" id="preview-reload" style="padding:.3rem .7rem;font-size:.85rem">Reload</button>

    <%# Click the page to change it. Holding shift does the same for one
        click, so a single paragraph does not need a mode turned on and then
        left on. %>
    <span id="edit-hint" class="muted" hidden
          style="font-size:.8rem">select or click any text or picture below</span>
    <button type="button" class="btn ghost" id="edit-on-page" aria-pressed="false"
            style="padding:.3rem .7rem;font-size:.85rem"
            title="Select or click any text, or click a picture, to edit it.">
      Click to edit
    </button>

    <%# Only for a bulletin, and only the two things you actually do with one. %>
    <% bulletins = @revision.pages.bulletins.pluck(:slug) %>
    <% if bulletins.any? %>
      <span id="bulletin-exports" hidden>
        <%= link_to "PDF", "#", id: "download-pdf", class: "btn ghost",
              style: "padding:.3rem .7rem;font-size:.85rem" %>
        <%= link_to "Email", "#", id: "download-email", class: "btn ghost",
              style: "padding:.3rem .7rem;font-size:.85rem" %>
      </span>
      <script>
        // The buttons follow the pane: they appear when what you are looking
        // at is a bulletin, and point at that bulletin.
        (function () {
          var slugs = <%= bulletins.to_json.html_safe %>;
          var box = document.getElementById("bulletin-exports");
          var pdf = document.getElementById("download-pdf");
          var email = document.getElementById("download-email");
          var base = "<%= "/admin/revisions/#{@revision.id}/bulletin" %>";

          window.showBulletinExports = function (slug) {
            var is = slugs.indexOf(slug) >= 0;
            box.hidden = !is;
            if (!is) return;
            var q = "?slug=" + encodeURIComponent(slug);
            pdf.href = base + "/pdf" + q;
            email.href = base + "/email" + q;
          };
        })();
      </script>
    <% end %>
    <span class="grow"></span>
    <a class="muted" id="preview-open" href="#" target="_blank" rel="noopener">open in a tab ↗</a>
  </div>

  <% last = @messages.reverse.find { |m| m.role == "assistant" && m.touched.present? } %>

  <%# Which pages the last reply changed. One is the common case; a sweeping
      request touches several, and flicking between them should not mean
      hunting through the site. %>
  <div class="changed" id="changed" hidden>
    <span class="muted">Changed:</span>
    <span id="changed-list"></span>
  </div>

  <div class="stage" id="stage"
       data-latest-id="<%= last&.id %>"
       data-latest-slug="<%= Array(last&.touched).first %>"
       data-latest-all="<%= Array(last&.touched).to_json %>">
    <iframe id="preview" title="The draft as it looks now"></iframe>
  </div>
</section>

<script>
  // The preview pane. Which page and which width are remembered in this
  // browser, because a finished turn reloads the whole page and losing your
  // place on every reply would make the pane useless.
  (function () {
    var frame = document.getElementById("preview");
    if (!frame) return;

    var TOKEN = <%= @revision.preview_token.to_json.html_safe %>;
    var KEY = "sjoca.preview.<%= @revision.id %>";
    var stage = document.getElementById("stage");
    var where = document.getElementById("preview-where");
    var open = document.getElementById("preview-open");
    var wide = document.getElementById("w-wide");
    var phone = document.getElementById("w-phone");

    function remembered() {
      try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; }
    }
    function remember(extra) {
      var state = remembered();
      for (var k in extra) state[k] = extra[k];
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { /* private window */ }
      return state;
    }

    var state = remembered();
    var slug = state.slug || "home";

    // A finished turn reloads this page. If the reply changed a page, go and
    // look at THAT page -- that is the one worth seeing, and hunting for it was
    // the job the page selector used to do badly.
    //
    // Only once per reply: after the jump you are free to click elsewhere and
    // stay there, because the reply's id is remembered as already followed.
    var latestId = stage.dataset.latestId;
    var latestSlug = stage.dataset.latestSlug;
    var followedNow = false;
    if (latestSlug && latestId && latestId !== state.followed) {
      slug = latestSlug;
      followedNow = true;
      remember({ followed: latestId, slug: slug });
    }

    function pathFor(s) { return "/" + (s === "home" ? "" : s); }
    function url(s) { return pathFor(s) + "?preview=" + encodeURIComponent(TOKEN) + "&bare=1"; }
    function tabUrl(s) { return pathFor(s) + "?preview=" + encodeURIComponent(TOKEN); }

    function show(s, flash) {
      slug = s;
      // Reload even when the path has not changed: the draft underneath it has.
      frame.src = url(slug);
      open.href = tabUrl(slug);
      where.textContent = pathFor(slug);
      remember({ slug: slug });
      if (window.showBulletinExports) window.showBulletinExports(slug);

      if (!flash) return;
      // Dim and come back up once the new content is actually there, so the
      // eye is drawn to the finished page rather than to a blank frame.
      frame.addEventListener("load", function once() {
        frame.removeEventListener("load", once);
        stage.classList.remove("noticing");
        void stage.offsetWidth;          // restart the animation if it is already running
        stage.classList.add("noticing");
        setTimeout(function () { stage.classList.remove("noticing"); }, 1200);
      });
    }

    function setWidth(isPhone) {
      stage.classList.toggle("phone", isPhone);
      phone.setAttribute("aria-pressed", String(isPhone));
      wide.setAttribute("aria-pressed", String(!isPhone));
      remember({ phone: isPhone });
    }

    // The pages this reply changed, as buttons, so several are one click apart.
    var changed = [];
    try { changed = JSON.parse(stage.dataset.latestAll || "[]"); } catch (e) { changed = []; }
    if (changed.length) {
      var list = document.getElementById("changed-list");
      list.innerHTML = "";
      changed.forEach(function (s) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "changed-link";
        // A bare "/" is a cryptic thing to ask someone to click.
        b.textContent = s === "home" ? "home" : "/" + s;
        b.addEventListener("click", function () { show(s, true); });
        list.appendChild(b);
      });
      document.getElementById("changed").hidden = false;
    }

    setWidth(!!state.phone);

    // A reply that has just landed gets the flash; coming back to the page
    // later does not, or it would blink at you every time you opened a tab.
    show(slug, followedNow);

    // Clicking about inside the pane changes the page; say where you are, and
    // come back here next time.
    frame.addEventListener("load", function () {
      var here;
      try { here = frame.contentWindow.location.pathname; } catch (e) { return; }

      var at = here === "/" ? "home" : here.replace(/^\/|\/$/g, "");
      slug = at;
      where.textContent = here;
      open.href = tabUrl(at);
      remember({ slug: at });
      if (window.showBulletinExports) window.showBulletinExports(at);
    });

    wide.addEventListener("click", function () { setWidth(false); });
    phone.addEventListener("click", function () { setWidth(true); });
    document.getElementById("preview-reload").addEventListener("click", function () { show(slug); });
  })();

  // Clicking the page to change it.
  //
  // The pane and the page inside it are the same origin, so they can simply
  // talk: the button arms the overlay, and the overlay hands back anything
  // that belongs in the conversation instead.
  (function () {
    var frame = document.getElementById("preview");
    var button = document.getElementById("edit-on-page");
    if (!frame || !button) return;

    // Remembered, because the admin page reloads after every turn and the mode
    // was silently turning itself off. "I did it once and cannot do it again"
    // is what that feels like from the outside.
    var KEY = "sjoca.editmode.<%= @revision.id %>";
    var on = false;
    try { on = localStorage.getItem(KEY) === "1"; } catch (e) { on = false; }

    function paint() {
      button.setAttribute("aria-pressed", String(on));
      button.textContent = on ? "Done editing" : "Click to edit";
      button.classList.toggle("armed", on);
      var hint = document.getElementById("edit-hint");
      if (hint) hint.hidden = !on;
    }

    function tell() {
      try {
        frame.contentWindow.postMessage({ sjoca: "editing", on: on }, location.origin);
        frame.contentWindow.__sjocaEditMode = on;
      } catch (e) { /* not loaded yet; the load handler repeats it */ }
    }

    button.addEventListener("click", function () {
      on = !on;
      try { localStorage.setItem(KEY, on ? "1" : "0"); } catch (e) { /* private window */ }
      paint();
      tell();
    });

    paint();
    frame.addEventListener("load", tell);

    // "Ask about this" from the page: put it in the box, with the subject
    // named, and leave the person to say what they want done. It is not sent
    // for them -- they have not said anything yet.
    window.addEventListener("message", function (e) {
      if (e.origin !== location.origin || !e.data) return;

      // A rewrite that spans several blocks is handed to the conversation.
      // Reload so the turn is visible, rather than leaving the person looking
      // at a page that has not changed yet.
      if (e.data.sjoca === "working") { location.reload(); return; }

      if (e.data.sjoca !== "ask") return;

      var box = document.querySelector("#say textarea");
      if (!box) return;

      // The dialog says WHAT is being talked about; the person has already
      // said what they want done with it. Put both in the box as one request
      // and send it, so the whole thing runs through the ordinary turn -- with
      // the working bar, the steps, the cost and the transcript that go with
      // it.
      var subject;
      if (e.data.photo) {
        subject = "the photograph " + e.data.photo + " on /" + e.data.page;
      } else if (e.data.count > 1) {
        subject = "these " + e.data.count + " pieces on /" + e.data.page +
                  (e.data.excerpt ? ", beginning \u201c" + e.data.excerpt + "\u201d" : "");
      } else {
        subject = "the " + e.data.kind + " on /" + e.data.page +
                  (e.data.excerpt ? " that reads \u201c" + e.data.excerpt + "\u201d" : "");
      }

      box.value = "About " + subject + " (block" + (e.data.count > 1 ? "s " : " ") +
                  e.data.ids.join(", ") + "): " + e.data.instruction +
                  "\n\nChange only that — leave the rest of the page alone.";

      box.scrollIntoView({ block: "center" });
      // Sent, not left sitting: they have said what they want. Anything they
      // wanted to add, they would have added in the dialog.
      box.form.requestSubmit();
    });
  })();

  // Keep the newest message in view. The conversation scrolls inside its pane
  // now, so without this a long turn writes its steps off the bottom.
  (function () {
    var scroller = document.getElementById("scroller");
    if (!scroller) return;
    window.stickToBottom = function () { scroller.scrollTop = scroller.scrollHeight; };
    stickToBottom();
  })();

  // Polls while a turn is in flight. A turn can take eighty seconds, so the
  // page must visibly stay alive: the elapsed time ticks and each step appears
  // as it happens. A meta refresh in the body is not reliably honoured, which
  // is what left this looking dead.
  (function () {
    var bar = document.getElementById("working-bar");
    if (!bar) return;

    var url = "<%= status_admin_revision_path(@revision) %>";
    var started = Number(bar.dataset.since) * 1000 || Date.now();
    var steps = document.getElementById("working-steps");
    var clock = document.getElementById("working-clock");
    var cost = document.getElementById("working-cost");
    var latest = document.getElementById("working-latest");

    function tick() {
      var s = Math.round((Date.now() - started) / 1000);
      clock.textContent = s + "s";
    }

    function poll() {
      fetch(url, { headers: { Accept: "application/json" } })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.working) { location.reload(); return; }
          if (!steps) { setTimeout(poll, 1500); return; }
          steps.innerHTML = d.steps.map(function (t) {
            if (t.kind === "say") {
              // What it is thinking, in its own words, as it works.
              return "<span style=\"color:#222;font-style:normal;display:block;margin:.4rem 0\">" +
                     t.text.replace(/</g, "&lt;") + "</span>";
            }
            var mark = t.kind === "failed" ? "✗" : (t.kind === "read" ? "·" : "→");
            var colour = t.kind === "failed" ? "color:#8B1A1A" : "color:#666";
            return "<span style=\"" + colour + "\">" + mark + " " + t.text + "</span>";
          }).join("<br>");
          // The newest step, repeated in the pinned bar, so something is
          // visible even when you have scrolled back through the history.
          var word = document.getElementById("working-word");
          if (d.stopping && word) {
            word.firstChild.nodeValue = "Stopping";
          } else if (d.stalled && word) {
            // Nothing has happened for a minute. Say which it is, because
            // "Working..." with an animated ellipsis and no steps is the most
            // misleading thing this page can show.
            word.firstChild.nodeValue = d.queued_behind > 0 ? "Waiting its turn" : "Waiting";
            if (latest && !latest.textContent) {
              latest.textContent = d.queued_behind > 0
                ? "Another request is still running."
                : "Nothing has started yet. If this stays here, press Stop and send it again.";
            }
          }

          var last = d.steps[d.steps.length - 1];
          if (last && latest) latest.textContent = last.text;

          if (window.stickToBottom) window.stickToBottom();
          if (d.usage && d.usage.calls) {
            // Cached reads cost a tenth of fresh input, so showing them
            // together would hide the whole point of caching.
            var fresh = (d.usage.input + d.usage.output) / 1000;
            var cached = (d.usage.cache_read || 0) / 1000;
            cost.textContent = "· " + d.usage.calls + " calls, " +
              fresh.toFixed(1) + "k new" +
              (cached >= 0.1 ? " + " + cached.toFixed(0) + "k cached" : "");
          }
          setTimeout(poll, 1500);
        })
        .catch(function () { setTimeout(poll, 4000); });
    }

    setInterval(tick, 1000); tick();
    setTimeout(poll, 1200);
  })();
</script>

