<%# An invitation and a reset end at the same form. Only the greeting differs:
    somebody being invited has never been here and should be told where they
    are, and somebody resetting knows. %>
<% content_for :title, @invitation ? "Welcome — choose a password" : "Choose a new password" %>

<div style="max-width:24rem;margin:3rem auto">
  <h1 style="margin-top:0"><%= @invitation ? "Choose a password" : "Choose a new password" %></h1>
  <% if @invitation %>
    <p class="muted" style="margin-top:0">
      This is the editor for <strong><%= SiteDrop.new(Revision.live).name %></strong>.
      Once you are in, you ask for changes in plain words and see them before anybody else does.
    </p>
  <% end %>
  <p class="muted">At least 8 characters, with a capital, a small letter, and a number or symbol.</p>

  <%= form_with url: admin_password_path(token: params[:token]), scope: :password, method: :patch do |f| %>
    <p>
      <%= f.label :password, "New password", style: "display:block;margin-bottom:.2rem" %>
      <%= f.password_field :password, autofocus: true, required: true,
            autocomplete: "new-password", style: "width:100%;padding:.5rem" %>
    </p>
    <p>
      <%= f.label :password_confirmation, "Again", style: "display:block;margin-bottom:.2rem" %>
      <%= f.password_field :password_confirmation, required: true,
            autocomplete: "new-password", style: "width:100%;padding:.5rem" %>
    </p>
    <p><%= f.submit "Save it", class: "btn" %></p>
  <% end %>
</div>
