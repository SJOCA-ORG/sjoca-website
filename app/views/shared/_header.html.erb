<header class="site-header" data-controller="nav">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">SJTB</a>

    <button class="site-header__toggle" type="button"
            aria-label="Menu" aria-expanded="false" data-action="nav#toggle">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" data-nav-target="menu" aria-label="Main">
      <ul class="site-nav__list">
        <% @nav.each do |item| %>
          <% kids = item.children %>
          <li class="site-nav__item <%= "has-children" if kids.any? %>">
            <a href="<%= item.path %>"
               class="site-nav__link <%= "is-current" if item.slug == @page&.slug %>"
               <%= "aria-current=page".html_safe if item.slug == @page&.slug %>>
              <%= item.nav_title %>
              <% if kids.any? %><span class="site-nav__caret" aria-hidden="true"></span><% end %>
            </a>
            <% if kids.any? %>
              <ul class="site-nav__sub">
                <%# A parent with its own content lists itself first, so the
                    submenu does not imply the parent is only a heading. %>
                <% if item.self_nav_title.present? %>
                  <li>
                    <a href="<%= item.path %>"
                       class="<%= "is-current" if item.slug == @page&.slug %>"><%= item.self_nav_title %></a>
                  </li>
                <% end %>
                <% kids.each do |kid| %>
                  <li>
                    <a href="<%= kid.path %>"
                       class="<%= "is-current" if kid.slug == @page&.slug %>"><%= kid.nav_title %></a>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
