<%# Clicking the site to change it.

    Mitch's shape, after two worse ones of mine. Arm the page, then either
    click a thing or select across several -- both open the same dialog. There
    is no intermediate button to hunt for, which also deletes the bug that had:
    a drag ends in a click, and the click handler dismissed the offer the drag
    had just produced.

    The dialog shows the thing, lets you ask the AI about it, and has Cancel
    and Save. For text you can simply type over it; for a photograph there is
    nothing to type, so asking is the only way in.

    Renders ONLY inside the admin's preview pane, for a draft. The public site
    gets none of it. %>
<style>
  html.editing [data-block] { outline: 1px dashed rgba(109,6,6,.5); outline-offset: 3px;
                              cursor: pointer; }
  html.editing [data-block]:hover { outline: 2px solid #6D0606; background: rgba(109,6,6,.07); }
  html.editing::before {
    content: "Select or click any text, or click a picture, to edit it";
    position: fixed; top: 0; left: 0; right: 0; z-index: 2147482000;
    background: #6D0606; color: #fff; text-align: center; padding: .25rem;
    font: 12px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  html.editing body { padding-top: 1.4rem; }

  #sj-back { position: fixed; inset: 0; z-index: 2147483100; background: rgba(0,0,0,.45);
             display: flex; align-items: center; justify-content: center; padding: 1.5rem;
             font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
  #sj-box { background: #fff; border-radius: 10px; width: min(820px, 100%); max-height: 88vh;
            display: flex; flex-direction: column; overflow: hidden; }
  #sj-box h3 { margin: 0; padding: .8rem 1rem; border-bottom: 1px solid #e3e3e3;
               font-size: 15px; font-weight: 600; }
  #sj-box h3 span { font-weight: 400; color: #777; }
  #sj-body { flex: 1; overflow: auto; display: flex; flex-direction: column; min-height: 220px; }
  #sj-text { flex: 1; min-height: 240px; border: 0; padding: 1rem; font: inherit; resize: none;
             outline: none; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
             font-size: 14px; }
  #sj-photo { padding: 1rem; display: flex; gap: 1rem; align-items: flex-start; }
  #sj-photo img { width: 220px; border-radius: 6px; border: 1px solid #ddd; }
  #sj-photo dl { margin: 0; font-size: 14px; }
  #sj-photo dt { color: #777; font-size: 12px; margin-top: .5rem; }
  #sj-photo dd { margin: 0; }

  #sj-ask { border-top: 1px solid #e3e3e3; padding: .7rem 1rem; background: #FDF6E3; }
  #sj-ask label { display: block; font-size: 12px; color: #666; margin-bottom: .3rem; }
  #sj-ask .line { display: flex; gap: .5rem; }
  #sj-ask input { flex: 1; font: inherit; font-size: 14px; padding: .45rem .6rem;
                  border: 1px solid #ccc; border-radius: 6px; }
  #sj-foot { padding: .7rem 1rem; border-top: 1px solid #e3e3e3; display: flex;
             align-items: center; gap: .6rem; }
  #sj-foot .grow { flex: 1; }
  .sj-btn { border: 1px solid #212121; background: #212121; color: #fff; padding: .4rem 1rem;
            border-radius: 6px; cursor: pointer; font: inherit; font-size: 14px; }
  .sj-btn.ghost { background: #fff; color: #212121; }
  .sj-btn[disabled] { opacity: .5; cursor: default; }
  #sj-note { color: #777; font-size: 13px; }
  #sj-note.bad { color: #8B1A1A; }
</style>

<script>
  (function () {
    var REVISION = <%= @revision_id_for_editing.to_json.html_safe %>;
    var back, state;

    function armed() { return document.documentElement.classList.contains("editing"); }

    window.addEventListener("message", function (e) {
      if (!e.data || e.data.sjoca !== "editing") return;
      document.documentElement.classList.toggle("editing", !!e.data.on);
      shut();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") shut();
    });

    // One gesture, two readings. Mouseup rather than click, because a drag
    // ends in both and the click is where the previous version went wrong.
    document.addEventListener("mouseup", function (e) {
      if (!armed() || back) return;
      if (e.target.closest("#sj-back")) return;

      // Let the selection settle before reading it.
      setTimeout(function () { decide(e); }, 10);
    });

    function decide(e) {
      var sel = document.getSelection();
      var blocks;

      if (sel && !sel.isCollapsed && sel.toString().trim() && sel.rangeCount) {
        blocks = inRange(sel.getRangeAt(0));
      } else {
        var one = e.target.closest("[data-block]");
        blocks = one ? [one] : [];
      }
      if (!blocks.length) return;

      // Whole blocks, never the literal selection: half a sentence to edit
      // produces text that joins up at neither end.
      open(blocks.map(function (el) { return el.dataset.block; }));
      if (sel) sel.removeAllRanges();
    }

    function inRange(range) {
      var all = [].slice.call(document.querySelectorAll("[data-block]"));
      return all.filter(function (el) {
        try { return range.intersectsNode(el); } catch (err) { return false; }
      }).filter(function (el) {
        return !all.some(function (other) { return other !== el && other.contains(el); });
      });
    }

    function shut() {
      if (back) { back.remove(); back = null; }
      state = null;
    }

    function open(ids) {
      Promise.all(ids.map(function (id) {
        return fetch("/admin/revisions/" + REVISION + "/blocks/" + id,
                     { headers: { Accept: "application/json" } }).then(function (r) { return r.json(); });
      })).then(function (blocks) {
        // What it said when we opened it, so Cancel means something even after
        // the AI has been at it.
        state = { blocks: blocks, ids: blocks.map(function (b) { return b.id; }),
                  original: blocks.map(function (b) { return b.content; }) };
        draw();
      });
    }

    function draw() {
      shutOnly();
      var blocks = state.blocks;
      var photo = blocks.length === 1 && blocks[0].photo;
      var many = blocks.length > 1;

      back = document.createElement("div");
      back.id = "sj-back";
      back.innerHTML =
        '<div id="sj-box">' +
          '<h3>' + (photo ? "This photograph" : "This text") +
            ' <span>— ' + (many ? blocks.length + " pieces" : blocks[0].kind) +
            " on /" + blocks[0].page + (many ? ", which may end up as a different number" : "") +
          '</span></h3>' +
          '<div id="sj-body"></div>' +
          '<div id="sj-ask">' +
            '<label>' + (photo ? "Ask for a change — “crop this square”, “find a sharper one”"
                               : "Or ask for a change — “make this shorter”, “say it more warmly”") + '</label>' +
            '<div class="line">' +
              '<input id="sj-instruction" placeholder="what would you like done?">' +
              '<button type="button" class="sj-btn" id="sj-send">Ask</button>' +
            '</div>' +
          '</div>' +
          '<div id="sj-foot">' +
            '<span id="sj-note"></span><span class="grow"></span>' +
            '<button type="button" class="sj-btn ghost" id="sj-cancel">Cancel</button>' +
            '<button type="button" class="sj-btn" id="sj-save">Save</button>' +
          '</div>' +
        '</div>';
      document.body.appendChild(back);

      var body = back.querySelector("#sj-body");
      if (photo) {
        body.innerHTML =
          '<div id="sj-photo">' +
            '<img src="/media/' + blocks[0].photo + '/' + blocks[0].version + '" alt="">' +
            '<dl>' +
              '<dt>Name</dt><dd>' + blocks[0].photo + '</dd>' +
              '<dt>Version</dt><dd>' + blocks[0].version + '</dd>' +
              '<dt>On</dt><dd>/' + blocks[0].page + '</dd>' +
            '</dl>' +
          '</div>';
        back.querySelector("#sj-save").disabled = true;   // nothing to type over
      } else {
        body.innerHTML = '<textarea id="sj-text" spellcheck="true"></textarea>';
        var box = body.querySelector("#sj-text");
        box.value = blocks.map(function (b) { return readable(b.content); }).join("\n\n");
        box.focus();
        box.addEventListener("keydown", function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key === "Enter") save();
        });
      }

      back.addEventListener("click", function (e) { if (e.target === back) cancel(); });
      back.querySelector("#sj-cancel").addEventListener("click", cancel);
      back.querySelector("#sj-save").addEventListener("click", save);
      back.querySelector("#sj-send").addEventListener("click", ask);
      back.querySelector("#sj-instruction").addEventListener("keydown", function (e) {
        if (e.key === "Enter") ask();
      });
    }

    function shutOnly() { if (back) { back.remove(); back = null; } }

    // "New York &amp; the Diocese" is not something to ask a parish volunteer
    // to understand, let alone preserve. The few entities that actually turn
    // up in this content are shown as the characters they stand for; a plain
    // "&" typed back renders correctly, so nothing needs re-encoding.
    //
    // Only these five. Decoding everything would turn markup somebody meant to
    // write -- a &lt; they wanted on the page -- into markup that acts.
    function readable(text) {
      return String(text)
        .replace(/&amp;/g, "&")
        .replace(/&nbsp;/g, " ")
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&rsquo;/g, "\u2019");
    }

    function note(text, bad) {
      var el = back && back.querySelector("#sj-note");
      if (!el) return;
      el.className = bad ? "bad" : "";
      el.textContent = text;
    }

    // Cancel puts back what it said when the dialog opened -- including undoing
    // anything the AI changed while it was open. Otherwise "Cancel" would mean
    // "cancel my typing but keep everything else", which is not what the word
    // means.
    function cancel() {
      var changed = state && state.blocks.some(function (b, i) {
        return b.content !== state.original[i];
      });
      if (!changed) { shut(); return; }

      note("Putting it back…");
      Promise.all(state.ids.map(function (id, i) {
        return fetch("/admin/revisions/" + REVISION + "/blocks/" + id, {
          method: "PATCH", headers: headers(),
          body: JSON.stringify({ content: state.original[i] }),
        });
      })).then(function () { shut(); location.reload(); });
    }

    function headers() {
      return {
        "Content-Type": "application/json",
        "X-CSRF-Token": (document.querySelector("meta[name=csrf-token]") || {}).content || "",
      };
    }

    function save() {
      var box = back.querySelector("#sj-text");
      if (!box) return;
      note("Saving…");

      fetch("/admin/revisions/" + REVISION + "/blocks/rewrite", {
        method: "POST", headers: headers(),
        body: JSON.stringify({ block_ids: state.ids, content: box.value }),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (r) {
          if (!r.ok) return note(r.body.error || "It would not save.", true);
          shut();
          if (r.body.handled === "conversation") {
            parent.postMessage({ sjoca: "working" }, location.origin);
          } else {
            location.reload();
          }
        })
        .catch(function () { note("It would not save.", true); });
    }

    // Ask, and WAIT -- the dialog stays open and refills itself when the turn
    // finishes, so the text can be looked at, edited again, saved or thrown
    // away. Closing the dialog to go and read the chat would lose the thread.
    function ask() {
      var input = back.querySelector("#sj-instruction");
      var said = input.value.trim();
      if (!said) return;

      input.disabled = true;
      back.querySelector("#sj-send").disabled = true;
      note("Asking…");

      fetch("/admin/revisions/" + REVISION + "/blocks/discuss", {
        method: "POST", headers: headers(),
        body: JSON.stringify({ block_ids: state.ids, instruction: said }),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (r) {
          if (!r.ok) {
            input.disabled = false;
            back.querySelector("#sj-send").disabled = false;
            return note(r.body.error || "It would not ask.", true);
          }
          input.value = "";
          watch();
        });
    }

    function watch() {
      var since = Date.now();
      note("Working…");

      (function again() {
        if (!back) return;
        fetch("/admin/revisions/" + REVISION + "/status", { headers: { Accept: "application/json" } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!back) return;
            if (d.working) {
              var step = d.steps && d.steps.length ? d.steps[d.steps.length - 1].text : "";
              note("Working… " + Math.round((Date.now() - since) / 1000) + "s " +
                   (step ? "· " + step : ""));
              return setTimeout(again, 1500);
            }
            refill();
          })
          .catch(function () { setTimeout(again, 3000); });
      })();
    }

    function refill() {
      var query = state.ids.map(function (id) { return "ids[]=" + id; }).join("&");
      fetch("/admin/revisions/" + REVISION + "/blocks/current?" + query,
            { headers: { Accept: "application/json" } })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!back) return;

          // Blocks can be gone entirely -- the AI may have replaced three
          // paragraphs with two. Say so rather than showing half an answer.
          if (!d.blocks.length) { shut(); location.reload(); return; }

          var input = back.querySelector("#sj-instruction");
          var send = back.querySelector("#sj-send");
          var box = back.querySelector("#sj-text");

          state.blocks = d.blocks.map(function (b, i) {
            return { id: b.id, kind: b.kind, content: b.content, photo: b.photo,
                     version: b.version, page: state.blocks[0].page };
          });
          if (box) box.value = d.blocks.map(function (b) { return readable(b.content); }).join("\n\n");
          if (input) { input.disabled = false; input.focus(); }
          if (send) send.disabled = false;
          note("Done — look it over, then Save or Cancel.");

          // A photograph changed under us: show the new one.
          var img = back.querySelector("#sj-photo img");
          if (img && d.blocks[0].photo) {
            img.src = "/media/" + d.blocks[0].photo + "/" + d.blocks[0].version + "?t=" + Date.now();
          }
        });
    }
  })();
</script>
