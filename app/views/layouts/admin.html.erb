<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Site admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <style>
      :root { --ink:#212121; --maroon:#6D0606; --rule:#D3D3D3; --band:#F6F6F6; }
      * { box-sizing:border-box }
      body { margin:0; font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
             color:var(--ink); background:#fff }
      header.bar { background:var(--ink); color:#fff; padding:.7rem 1.2rem; display:flex;
                   align-items:center; gap:1rem }
      header.bar a { color:#fff; text-decoration:none; opacity:.85 }
      header.bar a:hover { opacity:1 }
      header.bar .grow { flex:1 }
      /* The shell is a column: bar, then everything else. Pages that want the
         whole viewport (the workbench) can then fill it without guessing how
         tall the bar is. */
      body { display:flex; flex-direction:column; height:100vh }
      header.bar { flex:0 0 auto }
      main { flex:1; min-height:0; overflow-y:auto;
             max-width:1100px; width:100%; margin:0 auto; padding:1.5rem 1.2rem 4rem }
      main.workbench { max-width:none; padding:0; overflow:hidden; display:flex }
      h1 { font-size:1.35rem; margin:.2rem 0 1rem }
      h2 { font-size:1.05rem; margin:2rem 0 .6rem }
      .card { border:1px solid var(--rule); border-radius:8px; padding:1rem; margin-bottom:.8rem }
      .card.live { border-color:var(--maroon); border-width:2px }
      .muted { color:#666; font-size:.88rem }
      .row { display:flex; align-items:center; gap:.8rem; flex-wrap:wrap }
      .grow { flex:1 }
      .btn { display:inline-block; border:1px solid var(--ink); background:var(--ink); color:#fff;
             padding:.4rem .9rem; border-radius:6px; text-decoration:none; font-size:.9rem;
             cursor:pointer; font-family:inherit }
      .btn.ghost { background:#fff; color:var(--ink) }
      .btn.danger { background:#fff; color:var(--maroon); border-color:var(--maroon) }
      .tag { font-size:.75rem; text-transform:uppercase; letter-spacing:.05em;
             padding:.15rem .5rem; border-radius:99px; background:var(--band) }
      .tag.live { background:var(--maroon); color:#fff }
      .notice { background:#EAF5EA; border:1px solid #BBD9BB; padding:.6rem 1rem;
                border-radius:6px; margin-bottom:1rem }
      .chat { display:flex; flex-direction:column; gap:.7rem; margin:1rem 0 }

      /* ---- the workbench: controls and conversation at the left, the actual
         page at the right, because judging a change by reading about it is not
         the same as looking at it. ---- */
      .workbench .pane-left {
        flex:0 0 27rem; min-width:21rem; display:flex; flex-direction:column;
        min-height:0; border-right:1px solid var(--rule); background:#fff;
      }
      .workbench .pane-left > .fixed { flex:0 0 auto; padding:.9rem 1rem; }
      .workbench .pane-left > .fixed.top { border-bottom:1px solid var(--rule) }
      .workbench .pane-left > .fixed.bottom { border-top:1px solid var(--rule) }

      /* The conversation scrolls; the panes themselves never do. Without this
         a long turn pushed the newest step and the "working" indicator off the
         bottom of the page at the same time. */
      .workbench .scroller { flex:1; min-height:0; overflow-y:auto; padding:0 1rem; }
      .workbench .chat { margin:.8rem 0 }
      .workbench .msg { max-width:none }

      /* Pinned above the conversation, not inside it, so it survives however
         far the steps scroll. */
      .working-bar { display:flex; align-items:baseline; gap:.5rem; flex-wrap:wrap;
                     margin:.7rem 0 0; padding:.5rem .7rem; border-radius:8px;
                     background:#FDF6E3; border:1px solid #E6D9A8; font-size:.9rem }
      .working-bar .latest { flex:0 0 100%; color:#555; font-size:.82rem;
                             white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
      .working-bar .muted { font-size:.82rem }
      .working-bar .linky { border:0; background:none; color:var(--maroon); cursor:pointer;
                            font:inherit; font-size:.85rem; text-decoration:underline; padding:0 }

      .workbench .pane-right { flex:1; min-width:0; display:flex; flex-direction:column;
                               background:var(--band) }
      .preview-bar { flex:0 0 auto; display:flex; align-items:center; gap:.6rem;
                     padding:.5rem .9rem; border-bottom:1px solid var(--rule); background:#fff }
      .preview-bar select { font:inherit; font-size:.88rem; padding:.3rem .4rem;
                            border:1px solid var(--rule); border-radius:6px; max-width:16rem }
      .seg { display:inline-flex; border:1px solid var(--rule); border-radius:6px; overflow:hidden }
      .seg button { font:inherit; font-size:.85rem; padding:.3rem .7rem; border:0;
                    background:#fff; cursor:pointer; color:var(--ink) }
      .seg button[aria-pressed="true"] { background:var(--ink); color:#fff }
      /* Armed should look armed. A button whose only change was its label was
         not telling anybody anything. */
      .btn.armed { background:var(--maroon); border-color:var(--maroon); color:#fff }

      .changed { flex:0 0 auto; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;
                 padding:.4rem .9rem; border-bottom:1px solid var(--rule); background:#FDF6E3;
                 font-size:.85rem }
      .changed-link { font:inherit; border:1px solid #E6D9A8; background:#fff; cursor:pointer;
                      border-radius:99px; padding:.15rem .6rem; color:var(--ink) }
      .changed-link:hover { border-color:var(--ink) }

      .stage { flex:1; min-height:0; overflow:auto; display:flex; justify-content:center;
               padding:0 }

      /* When a change lands, dim the page and bring it back up. A quiet reload
         in a pane you were not looking at is a change you do not notice. */
      .stage.noticing iframe { animation: noticing .9s ease-out }
      @keyframes noticing {
        0%   { filter:brightness(.3) saturate(.5) }
        45%  { filter:brightness(1.12) saturate(1.05) }
        100% { filter:none }
      }
      @media (prefers-reduced-motion: reduce) {
        .stage.noticing iframe { animation:none; outline:3px solid var(--maroon); outline-offset:-3px }
      }
      .stage.phone { padding:1.2rem }
      .stage iframe { width:100%; height:100%; border:0; background:#fff }
      /* 390px is the width the browser checks use, so what you see here is what
         the automatic check sees. */
      .stage.phone iframe { width:390px; flex:0 0 390px; height:844px; max-height:100%;
                            border:1px solid var(--rule); border-radius:14px;
                            box-shadow:0 2px 14px rgba(0,0,0,.13) }

      @media (max-width: 900px) {
        main.workbench { flex-direction:column; overflow-y:auto }
        .workbench .pane-left { flex:0 0 auto; border-right:0; border-bottom:1px solid var(--rule) }
        .workbench .scroller { overflow:visible }
        .workbench .pane-right { min-height:70vh }
      }
      .msg { padding:.7rem 1rem; border-radius:10px; max-width:46rem; white-space:pre-wrap }
      .msg.user { background:var(--ink); color:#fff; align-self:flex-end }
      .msg.assistant { background:var(--band); align-self:flex-start }
      /* Still going, not finished: a long job should not read as a run of
         failed attempts. */
      .msg.assistant.interim { background:#FDF6E3; border:1px solid #E6D9A8;
                               font-size:.88rem; color:#555 }
      .msg .tools { display:block; margin-top:.5rem; font-size:.8rem; color:#555;
                    border-top:1px solid var(--rule); padding-top:.4rem }
      /* .msg is pre-wrap so a reply keeps its paragraphs. The step list is
         markup, not prose, so every newline and indent in the template was
         being rendered as blank space -- a column of six steps a screen tall. */
      .msg .tools, .msg details { white-space:normal }
      /* The working box is entirely markup -- no prose to preserve -- so the
         template's own indentation was showing up as a gap under the clock. */
      #working { white-space:normal }
      .msg .tools span { display:block; line-height:1.5 }
      textarea { width:100%; font:inherit; padding:.7rem; border:1px solid var(--rule);
                 border-radius:8px; resize:vertical }
      .empty { color:#777; padding:2rem 0 }
      .dots { animation: blink 1.4s infinite }
      @keyframes blink { 0%,100% { opacity:.3 } 50% { opacity:1 } }
    </style>
    <script>
      // Take the frame HERE, before anything is uploaded.
      //
      // A 4K phone video is hundreds of megabytes and the frame out of it is
      // about forty kilobytes. Sending the whole clip to get one picture back
      // is a long wait on a parish broadband connection, and it is the entire
      // reason the server cap exists. The browser can already decode the video
      // -- it is the same decoder that plays it -- so it can hand us the frame
      // without the file ever leaving the machine.
      //
      // The server still knows how (ffmpeg), for a format the browser cannot
      // play and for anyone with JavaScript off. This is the fast path, not
      // the only one.
      window.frameFromVideo = function (file) {
        return new Promise(function (resolve) {
          var url = URL.createObjectURL(file);
          var video = document.createElement("video");
          var done = false;

          function give(value) {
            if (done) return;
            done = true;
            URL.revokeObjectURL(url);
            resolve(value);
          }

          // If anything at all goes wrong, fall back to uploading the clip.
          video.addEventListener("error", function () { give(null); });
          setTimeout(function () { give(null); }, 15000);

          video.addEventListener("loadeddata", function () {
            // Not frame zero: the first frame of a phone video is very often
            // black or a blurred hand. A second in, or halfway through a clip
            // shorter than that.
            var at = Math.min(1, (video.duration || 2) / 2);
            video.currentTime = isFinite(at) ? at : 0;
          });

          video.addEventListener("seeked", function () {
            try {
              var canvas = document.createElement("canvas");
              canvas.width = video.videoWidth;
              canvas.height = video.videoHeight;
              if (!canvas.width || !canvas.height) return give(null);

              canvas.getContext("2d").drawImage(video, 0, 0);
              canvas.toBlob(function (blob) {
                if (!blob) return give(null);
                var name = file.name.replace(/\.[^.]+$/, "") + ".jpg";
                give(new File([blob], name, { type: "image/jpeg" }));
              }, "image/jpeg", 0.9);
            } catch (e) {
              give(null);
            }
          });

          video.muted = true;
          video.playsInline = true;
          video.preload = "auto";
          video.src = url;
        });
      };

      window.isVideoFile = function (file) {
        return (file.type || "").indexOf("video/") === 0 ||
               /\.(mp4|mov|mpe?g|m4v|webm|avi|3gp)$/i.test(file.name);
      };

      // Replace every video in a file input with the still taken from it.
      // Returns what happened, so the page can say so.
      window.stillsFromVideos = async function (input) {
        var files = [].slice.call(input.files || []);
        if (!files.some(window.isVideoFile)) return { converted: [], uploaded: [] };

        var box = new DataTransfer(), converted = [], uploaded = [];
        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          if (!window.isVideoFile(file)) { box.items.add(file); continue; }

          var still = await window.frameFromVideo(file);
          if (still) { box.items.add(still); converted.push(file.name); }
          else { box.items.add(file); uploaded.push(file.name); }
        }
        input.files = box.files;
        return { converted: converted, uploaded: uploaded };
      };
    </script>
  </head>
  <body>
    <header class="bar">
      <strong><%= link_to "Site admin", admin_root_path %></strong>
      <%= link_to "Photographs", admin_photos_path %>
      <%= link_to "Bulletins", admin_bulletins_path %>
      <span class="grow"></span>
      <%= link_to "View live site", root_path, target: "_blank", rel: "noopener" %>
    </header>
    <% if notice || alert %>
      <div style="flex:0 0 auto;padding:.6rem 1.2rem 0">
        <% if notice %><p class="notice" style="margin:0"><%= notice %></p><% end %>
        <% if alert %><p class="notice" style="margin:0;background:#FBEAEA;border-color:#E0B4B4"><%= alert %></p><% end %>
      </div>
    <% end %>
    <main class="<%= content_for(:main_class) %>">
      <%= yield %>
    </main>
  </body>
</html>
