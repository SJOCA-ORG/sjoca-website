<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Saint John the Baptist Orthodox Church" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) ||
      "Saint John the Baptist Orthodox Church, Rochester NY — a parish of the Orthodox Church in America (OCA), Diocese of New York and New Jersey. Services entirely in English." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Parish mark: Flower City logo as a watermark behind an Orthodox three-bar
        cross. See docs/favicon.md for the design history and provenance. %>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-180.png">
    <link rel="manifest" href="<%= pwa_manifest_path %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Lato:wght@300;400;700&family=Quicksand:wght@400;500;600&family=Lobster&display=swap" %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if respond_to?(:previewing?) && previewing? %>
      <div style="background:#6D0606;color:#fff;padding:.5rem 1rem;font:14px system-ui;
                  display:flex;gap:1rem;align-items:center;position:sticky;top:0;z-index:999">
        <strong>Preview</strong>
        <span style="flex:1">You are looking at a draft, not the live site.</span>
        <%= link_to "Back to admin", admin_root_path, style: "color:#fff" %>
        <%= link_to "Exit preview", admin_exit_preview_path, style: "color:#fff" %>
      </div>
    <% end %>
    <a class="skip-link" href="#main">Skip to main content</a>
    <%= @header %>
    <main id="main"><%= yield %></main>
    <%= @footer %>
  </body>
</html>
