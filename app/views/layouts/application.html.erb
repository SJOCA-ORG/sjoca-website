<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Site::Seo::NAME %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || @seo&.description %>">
    <%# Everything a search engine is told about this page. @seo is set by the
        pages controller; anything else rendered through this layout simply
        does without. %>
    <% unless @indexable %>
      <%# A preview, an error page, anything without SEO: keep it out of the
          index. A draft at a signed address is not for the public. %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>

    <% if @indexable %>
      <link rel="canonical" href="<%= @seo.canonical %>">
      <% @seo.open_graph.each do |property, content| %>
        <meta property="<%= property %>" content="<%= content %>">
      <% end %>
      <meta name="twitter:card" content="summary_large_image">

      <%# A church, its address, and when it actually meets -- the service
          times taken from the calendar the parish already keeps, so they
          cannot drift from what is published. %>
      <script type="application/ld+json">
        <%= @seo.structured_data.to_json.html_safe %>
      </script>
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Parish mark: Flower City logo as a watermark behind an Orthodox three-bar
        cross. See docs/favicon.md for the design history and provenance. %>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-180.png">
    <link rel="manifest" href="<%= pwa_manifest_path %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Lato:wght@300;400;700&family=Quicksand:wght@400;500;600&family=Lobster&display=swap" %>
    <%# The stylesheet is a database row, so the parish can change it. See
        docs/liquid-vocabulary.md. %>
    <%= stylesheet_link_tag theme_stylesheet_path(digest: @theme_digest, preview: @preview), "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>


  </head>

  <body class="<%= @page_class %>">
    <%# The banner is skipped inside the admin's preview pane. There it is
        redundant -- the whole pane is labelled a draft -- and at phone width it
        ate a sixth of the viewport, which is the part you are trying to judge. %>
    <% if respond_to?(:previewing?) && previewing? && params[:bare].blank? %>
      <div style="background:#6D0606;color:#fff;padding:.5rem 1rem;font:14px system-ui;
                  display:flex;gap:1rem;align-items:center;position:sticky;top:0;z-index:999">
        <strong>Preview</strong>
        <span style="flex:1">You are looking at a draft, not the live site.</span>
        <%= link_to "Back to admin", admin_root_path, style: "color:#fff" %>
        <%= link_to "Exit preview", admin_exit_preview_path, style: "color:#fff" %>
      </div>
    <% end %>
    <%# Only inside the admin's preview pane, which is what bare=1 means. The
        public site never loads this.

        Links in the page are ordinary ("/about-us"), so clicking one in the
        pane would leave the draft and land on the live site. Carrying the
        token in every link instead would mean the AI had to remember to add it
        to every link it ever writes in a template -- which it would eventually
        not do, silently. Rewriting on the way out needs nothing of anybody. %>
    <% if previewing? && params[:bare].present? %>
      <script>
        (function () {
          var keep = new URLSearchParams(location.search);
          document.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest("a[href]");
            if (!a || a.target === "_blank") return;

            var to = new URL(a.getAttribute("href"), location.href);
            if (to.origin !== location.origin) return;          // leave the parish's own links alone
            if (to.pathname === location.pathname && to.hash) return;  // in-page anchor

            e.preventDefault();
            to.searchParams.set("preview", keep.get("preview"));
            to.searchParams.set("bare", "1");
            location.href = to.toString();
          });
        })();
      </script>
    <% end %>
    <a class="skip-link" href="#main">Skip to main content</a>
    <%= @header %>
    <main id="main"><%= yield %></main>
    <%= @footer %>
    <% if @theme_js_digest %>
      <%= javascript_include_tag theme_javascript_path(digest: @theme_js_digest, preview: @preview), defer: true %>
    <% end %>
  </body>
</html>
