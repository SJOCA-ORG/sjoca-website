<%# The most recent class recordings, mirrored from the parish playlist so
    nobody maintains this list by hand. Links out to YouTube because the
    videos currently refuse embedding — see docs/TODO.md. %>
<% recordings = ClassRecording.latest(3) %>
<% if recordings.any? %>
  <div class="classes">
    <ul class="classes__list">
      <% recordings.each do |rec| %>
        <li class="classes__item">
          <a class="classes__link" href="<%= rec.watch_url %>" rel="noopener">
            <span class="classes__thumb">
              <%= image_tag rec.thumbnail_url, alt: "", loading: "lazy" %>
              <span class="classes__play" aria-hidden="true"></span>
            </span>
            <span class="classes__meta">
              <% if rec.number %><span class="classes__number">Class <%= rec.number %></span><% end %>
              <span class="classes__title"><%= rec.clean_title %></span>
              <% if rec.date_text %><span class="classes__date"><%= rec.date_text %></span><% end %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>

    <p class="classes__all">
      <a class="button" href="<%= Rails.application.config.adult_education.playlist_url %>"
         rel="noopener">All classes on YouTube</a>
    </p>
  </div>
<% end %>
