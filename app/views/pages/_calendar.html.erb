<%# The parish calendar, rendered from our own mirror of ChurchTrac.
    Grouped by week so the shape of the liturgical week is visible at a glance,
    rather than a flat list in which Vespers appears fifty times. %>
<div class="calendar">
  <% weeks = CalendarEvent.within(56).group_by { |e| e.starts_at.to_date.beginning_of_week(:sunday) } %>

  <% if weeks.empty? %>
    <p class="calendar__empty">
      The calendar is being updated. Please
      <a href="mailto:fr.david@sjoca.org">contact the parish</a> for service times.
    </p>
  <% else %>
    <% weeks.sort.each do |week_start, events| %>
      <section class="calendar__week">
        <h3 class="calendar__weekhead">
          <%= week_start == Date.current.beginning_of_week(:sunday) ? "This week" :
              "Week of #{week_start.strftime('%-d %B')}" %>
        </h3>

        <ol class="calendar__list">
          <% events.sort_by(&:starts_at).each do |event| %>
            <li class="calendar__item
                       <%= 'is-today' if event.starts_at.to_date == Date.current %>
                       <%= 'is-special' if event.noteworthy? %>
                       <%= 'is-cancelled' if event.cancellation? %>">
              <div class="calendar__when">
                <span class="calendar__day"><%= event.starts_at.strftime("%a") %></span>
                <span class="calendar__date"><%= event.starts_at.strftime("%-d") %></span>
              </div>
              <div class="calendar__what">
                <span class="calendar__title"><%= event.title %></span>
                <% if event.time_text %>
                  <span class="calendar__time"><%= event.time_text %></span>
                <% end %>
                <% if (place = event.elsewhere) %>
                  <span class="calendar__place"><%= place %></span>
                <% end %>
                <% if event.notes.present? %>
                  <span class="calendar__note"><%= event.notes %></span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  <% end %>
</div>
