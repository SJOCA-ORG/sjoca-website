<% site = SiteDrop.new(Current.revision) %>
<% content_for :title, "Page not found — #{site.name}" %>

<section class="band band--plain">
  <div class="band__inner">
    <h1>That page is not here</h1>
    <p>It may have moved, or the address may have a typo in it.
       Try the menu above<% if site.email.present? %>, or
       <a href="mailto:<%= site.email %>">email us</a> and we'll point you the
       right way<% end %>.</p>
  </div>
</section>
