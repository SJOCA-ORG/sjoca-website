<% case block.kind
   when "heading" %>
  <h2 class="b b-heading b--<%= block.align %>"><%= sanitize_inline(block.content) %></h2>

<% when "subheading" %>
  <p class="b b-subheading b--<%= block.align %>"><%= sanitize_inline(block.content) %></p>

<% when "text" %>
  <p class="b b-text b--<%= block.align %>"><%= sanitize_inline(block.content) %></p>

<% when "image" %>
  <% if (asset = block.asset) %>
    <%# Measured width from the current site, so images keep their original
        size rather than stretching to fill the column. %>
    <figure class="b b-image b--<%= block.align %>"
            <%= %(style=max-width:#{block.width}px).html_safe if block.width %>>
      <% if block.url.present? %>
        <a href="<%= block.url %>">
          <%= image_tag photo_path(asset.human_name), alt: asset.alt_text.to_s, loading: "lazy" %>
        </a>
      <% else %>
        <%= image_tag photo_path(asset.human_name), alt: asset.alt_text.to_s, loading: "lazy" %>
      <% end %>
    </figure>
  <% end %>

<% when "calendar" %>
  <div class="b b-calendar"><%= render "pages/calendar" %></div>

<% when "list" %>
  <%# One item per line in the content. Rendered as a real list so a screen
      reader announces how many there are. %>
  <ul class="b b-list b--<%= block.align %>">
    <% block.content.to_s.split("\n").map(&:strip).reject(&:blank?).each do |item| %>
      <li><%= sanitize_inline(item) %></li>
    <% end %>
  </ul>

<% when "quote" %>
  <blockquote class="b b-quote b--<%= block.align %>"><%= sanitize_inline(block.content) %></blockquote>

<% when "lectionary" %>
  <div class="b b-lectionary"><%= render "pages/lectionary" %></div>

<% when "classes" %>
  <div class="b b-classes"><%= render "pages/classes" %></div>

<% when "upcoming" %>
  <div class="b b-upcoming"><%= render "pages/upcoming" %></div>

<% when "embed" %>
  <% map = block.url.to_s.include?("google.com/maps") %>
  <div class="b b-embed <%= map ? "b-embed--map" : "b-embed--video" %>"
       <%= 'data-controller=embed data-action=click->embed#activate'.html_safe if map %>>
    <iframe src="<%= block.url %>"
            title="<%= map ? "Map of the parish" : "Adult education class recordings" %>"
            loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            <%= 'allowfullscreen'.html_safe unless map %>></iframe>
  </div>

<% when "button" %>
  <p class="b b--<%= block.align %>">
    <a class="button" href="<%= block.url %>"><%= sanitize_inline(block.content) %></a>
  </p>
<% end %>
