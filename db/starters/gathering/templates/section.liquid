{% comment %}
  The default section with more room to breathe. A starter overrides only what
  it wants to change; everything else comes from DefaultTemplates, so a block
  kind can never be left without a template to render it.

  The structure below is the default's, deliberately. The FIRST version of this
  file invented its own -- section.blocks instead of section.columns, and
  {% render 'block' %} instead of {% include block.template %} -- and rendered
  every band perfectly with nothing inside it. Liquid does not complain about a
  loop over nothing, so the page came out looking plausible and empty.
{% endcomment %}
<section class="band band--{{ section.style }} band--roomy">
  <div class="band__inner">
    <div class="cols" style="--tracks: {{ section.grid_template }}">
      {% for column in section.columns %}
        <div class="col">
          {% for block in column %}{% include block.template %}{% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
