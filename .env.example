# Operator settings — things OUTSIDE the application that need reading.
#
# Copy to .env and fill in. .env is gitignored and must stay that way: this
# repository is public.
#
#   cp .env.example .env
#
# Shell commands pick it up with:
#
#   set -a; source .env; set +a
#
# WHAT BELONGS HERE, AND WHAT DOES NOT
#
# Here: credentials used by tooling rather than by the running application —
# dumps, restores, one-off scripts.
#
# NOT here: anything the Rails application itself reads. That goes in
# config/credentials.yml.enc, which is encrypted, is committed, and which the
# server can already open because it holds RAILS_MASTER_KEY. The Anthropic key
# and the SMTP password live there and should stay there.

# The EXTERNAL database URL from the Render dashboard, for pulling production
# down and pushing a database up. The application never reads this -- Render
# injects DATABASE_URL into the container itself.
RENDER_DATABASE_URL=postgres://user:password@host.oregon-postgres.render.com/sjoca
